 position:sticky;top:0;z-index:50;
 background:radial-gradient(circle at 18% -40%,rgba(212,195,157,.46),transparent 42%),linear-gradient(115deg,#182f31 0%,#2c4644 54%,#5d6657 100%) !important;
 border-bottom:1px solid rgba(212,195,157,.72) !important;
 box-shadow:0 18px 45px rgba(18,35,35,.28),0 2px 0 rgba(184,154,98,.34);
 backdrop-filter:blur(18px);
}
