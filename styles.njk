.nav{height:132px !important;position:relative;max-width:1500px !important;padding:0 32px !important;gap:18px}
.navlinks{gap:20px !important}
.logo{
 width:430px !important;height:104px !important;object-fit:contain;object-position:left center;
 filter:drop-shadow(0 10px 16px rgba(0,0,0,.32)) drop-shadow(0 0 1px rgba(255,255,255,.45));
 background:rgba(250,248,241,.94);padding:7px 14px;border:1px solid rgba(212,195,157,.8);
 box-shadow:0 14px 32px rgba(0,0,0,.22),inset 0 0 0 1px rgba(255,255,255,.7);
}
.navlinks a{color:#f5f1e7 !important;opacity:.84 !important;text-shadow:0 2px 8px rgba(0,0,0,.2)}
.navlinks a:hover,.navlinks .active{color:#ead9b6 !important;opacity:1 !important}
.navlinks .btn-dark{color:#263b3b !important;background:linear-gradient(135deg,#eadbb9,#b89a62) !important;border-color:#d8c49a !important;box-shadow:0 10px 24px rgba(0,0,0,.25),inset 0 1px rgba(255,255,255,.55);text-shadow:none}
.header-photo{width:3.5cm;height:3.5cm;object-fit:contain;object-position:center;margin-left:24px;flex-shrink:0}
@media(max-width:900px){.nav{height:112px !important;padding:0 24px !important}.logo{width:340px !important;height:86px !important}.header-photo{width:2.6cm;height:2.6cm;margin-left:14px}}
@media(max-width:560px){.nav{height:96px !important;padding:0 18px !important}.logo{width:255px !important;height:72px !important;padding:5px 9px}.header-photo{width:1.9cm;height:1.9cm;margin-left:10px}}
</style>
